# PostgreSQL chạy bằng Docker: docker compose up -d postgres
# Cổng 5434: 5432 là PostgreSQL service của Windows, 5433 là container dự án khác.
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=

# NestJS API
PORT=
HOST=
CORS_ORIGINS=
PLATE_SESSION_HOURS=

# Storage và inference
PLATE_DATA_DIR=data
PLATE_CACHE_DIR=data/model-cache
PLATE_PIPELINE_PYTHON=.venv/Scripts/python.exe
PLATE_PIPELINES_CONFIG=config/pipelines.kaggle.json
PLATE_DEVICE=cuda
PLATE_POLL_SECONDS=2
# Live YouTube: số phiên chạy cùng lúc trong worker (0 là tắt), chu kỳ ghi stats, thời gian chờ dừng,
# giới hạn im lặng trước khi kill tiến trình treo, và không chạy job upload cùng lúc với live (GPU 8 GB).
PLATE_LIVE_MAX_SESSIONS=1
PLATE_LIVE_STATS_SECONDS=5
PLATE_LIVE_STOP_SECONDS=120
PLATE_LIVE_STALL_SECONDS=180
PLATE_LIVE_EXCLUSIVE_GPU=true
# SSE (API): heartbeat và số stream tối đa mỗi tiến trình API.
PLATE_SSE_HEARTBEAT_SECONDS=20
PLATE_SSE_MAX_CLIENTS=100
# Đủ cho video khoảng 2 giờ (10 GiB, timeout 6 giờ).
PLATE_MAX_UPLOAD_MIB=10240
PLATE_JOB_TIMEOUT_SECONDS=21600
