# PostgreSQL chạy bằng Docker: docker compose up -d postgres
# Cổng 5434: 5432 là PostgreSQL service của Windows, 5433 là container dự án khác.
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=

# NestJS API
PORT=
HOST=
CORS_ORIGINS=
PLATE_SESSION_HOURS=

# Storage và inference
PLATE_DATA_DIR=data
PLATE_CACHE_DIR=data/model-cache
PLATE_PIPELINE_PYTHON=.venv/Scripts/python.exe
PLATE_PIPELINES_CONFIG=config/pipelines.kaggle.json
PLATE_DEVICE=cuda
PLATE_POLL_SECONDS=2
# Đủ cho video khoảng 2 giờ (10 GiB, timeout 6 giờ).
PLATE_MAX_UPLOAD_MIB=10240
PLATE_JOB_TIMEOUT_SECONDS=21600
