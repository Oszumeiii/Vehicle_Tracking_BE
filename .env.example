# PostgreSQL chạy bằng Docker: docker compose up -d postgres
# Cổng 5434: 5432 là PostgreSQL service của Windows, 5433 là container dự án khác.
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=

# NestJS API
PORT=
HOST=
CORS_ORIGINS=
# Đứng sau reverse proxy (nginx, Caddy, tunnel): tin các proxy này để API thấy IP thật của người dùng
# (giới hạn đăng nhập sai, nhật ký truy cập). Số hop hoặc dải địa chỉ/preset (loopback, uniquelocal).
# Bỏ trống khi truy cập API trực tiếp; compose tự đặt "loopback, uniquelocal". Không nhận "true".
PLATE_TRUST_PROXY=
PLATE_SESSION_HOURS=
# Lifetime in minutes of the signed tokens in image/video URLs (default 60).
PLATE_ASSET_TOKEN_MINUTES=
# Đăng nhập sai quá số lần trong cửa sổ thì bị chặn tạm (429): theo email + địa chỉ, và theo địa chỉ.
PLATE_LOGIN_MAX_FAILURES=
PLATE_LOGIN_MAX_FAILURES_PER_ADDRESS=
PLATE_LOGIN_WINDOW_MINUTES=

# Storage và inference
PLATE_DATA_DIR=data
PLATE_CACHE_DIR=data/model-cache
PLATE_PIPELINE_PYTHON=.venv/Scripts/python.exe
PLATE_PIPELINES_CONFIG=config/pipelines.kaggle.json
PLATE_DEVICE=cuda
PLATE_POLL_SECONDS=2
# Live YouTube: số phiên chạy cùng lúc trong worker (0 là tắt), chu kỳ ghi stats, thời gian chờ dừng,
# giới hạn im lặng trước khi kill tiến trình treo, và không chạy job upload cùng lúc với live (GPU 8 GB).
# Từ 2 trở lên: các phiên chạy chung một tiến trình Python và một bản model (đo trên RTX 4060 8 GB:
# 2 camera tốn VRAM như 1). Hệ số lấy mẫu detector cho phiên chung, 1 là giữ nguyên pipeline.
PLATE_LIVE_MAX_SESSIONS=2
PLATE_LIVE_SHARED_SAMPLING_SCALE=1
# Giải mã luồng YouTube: none (CPU, mặc định) hoặc cuda (NVDEC trên GPU NVIDIA, chưa đo đủ).
# Số luồng giải mã ffmpeg mỗi camera; 0 là để ffmpeg tự chọn (bằng số nhân CPU).
PLATE_LIVE_HWACCEL=none
PLATE_LIVE_FFMPEG_THREADS=0
PLATE_LIVE_STATS_SECONDS=5
PLATE_LIVE_STOP_SECONDS=120
PLATE_LIVE_STALL_SECONDS=180
PLATE_LIVE_EXCLUSIVE_GPU=true
# Từ 2 phiên trở lên: host live còn chạy thêm số giây này sau phiên/job cuối để giữ model trong GPU
# (phiên hoặc job kế tiếp khỏi nạp lại khoảng 20 s); 0 là tắt ngay.
PLATE_LIVE_HOST_IDLE_SECONDS=300
# Ghi đệm liên tục camera live (đoạn 10 s, không mã hóa lại) và clip cho từng biển số:
# giữ bản ghi bao nhiêu phút, track nào được lưu clip lâu dài (readable|all|none), bao nhiêu giây trước/sau.
PLATE_LIVE_RECORD=true
PLATE_LIVE_RECORD_MINUTES=240
PLATE_LIVE_CLIP_POLICY=readable
PLATE_LIVE_CLIP_PAD_SECONDS=3
# Dọn bằng chứng live (worker) và cửa sổ gộp lượt xuất hiện cùng biển số.
PLATE_RETENTION_INTERVAL_MINUTES=10
PLATE_LIVE_SIGHTING_MINUTES=5
# SSE (API): heartbeat và số stream tối đa mỗi tiến trình API.
PLATE_SSE_HEARTBEAT_SECONDS=20
PLATE_SSE_MAX_CLIENTS=100
# Đủ cho video khoảng 2 giờ (10 GiB, timeout 6 giờ).
PLATE_MAX_UPLOAD_MIB=10240
PLATE_JOB_TIMEOUT_SECONDS=21600
# Chống đầy ổ: dưới ngưỡng này (GB trống trên ổ chứa PLATE_DATA_DIR) worker dừng camera live,
# không bật phiên mới và API từ chối upload (507); 0 là tắt.
PLATE_MIN_FREE_GB=5
# Hạn lưu tự đặt cho camera khi bật 24/7 mà chưa có hạn lưu: keyframe (giờ) và track (ngày); 0 là giữ mãi.
PLATE_ALWAYS_ON_KEYFRAME_HOURS=24
PLATE_ALWAYS_ON_TRACK_DAYS=7
# Nhật ký truy cập giữ bao nhiêu ngày; chặng hành trình nhanh hơn mức này (km/h) bị coi là vô lý.
PLATE_AUDIT_RETENTION_DAYS=365
PLATE_JOURNEY_MAX_KMH=150
# Số job upload worker chạy song song (mỗi job một tiến trình Python, VRAM tăng theo số job).
PLATE_WORKER_CONCURRENCY=1
# ffmpeg cho API (remux HLS, cắt video); bỏ trống thì lấy từ gói imageio-ffmpeg của Python.
# PLATE_FFMPEG=
# Mật khẩu tài khoản admin tạo bằng lệnh khởi tạo (không có mật khẩu mặc định).
# PLATE_ADMIN_PASSWORD=

# Deploy bằng compose (docs/DEPLOY.md).
# Tên miền cho Caddy (profile public), tự lấy chứng chỉ HTTPS; DNS phải trỏ về máy này.
# PLATE_DOMAIN=plates.example.com
# Kéo image do CI đẩy lên GHCR thay vì build trên server (tag latest hoặc phiên bản như 1.2.0).
# PLATE_IMAGE_PREFIX=ghcr.io/oszumeiii/
# PLATE_IMAGE_TAG=latest
# Service backup: pg_dump vào data/backups mỗi bao nhiêu giờ, giữ bao nhiêu ngày.
# PLATE_BACKUP_HOURS=24
# PLATE_BACKUP_DAYS=14
