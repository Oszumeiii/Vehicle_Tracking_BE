@startuml
!include _dfd.iuml
skinparam defaultFontSize 13
title Hình 1.5 – DFD mức dưới đỉnh của 7.0 Nhận diện live (mới)
top to bottom direction
rectangle "User" <<ext>> as U
rectangle "Nguồn video live" <<ext>> as S
usecase "7.1\nQuản lý camera,\nbật/dừng phiên" <<newproc>> as P1
usecase "7.2\nNhận phiên,\nchia GPU" <<newproc>> as P2
usecase "7.3\nĐọc luồng\n(yt-dlp, ffmpeg, Pacer)" <<newproc>> as P3
usecase "7.4\nPhát hiện, theo dõi,\nchọn 5 crop" <<newproc>> as P4
usecase "7.5\nOCR joint,\nphân loại theo ngưỡng" <<newproc>> as P5
usecase "7.6\nNhập track,\ngom lượt xuất hiện" <<newproc>> as P6
usecase "7.7\nKhớp watchlist" <<newproc>> as P7
usecase "7.8\nĐẩy sự kiện (SSE)" <<newproc>> as P8
usecase "7.9\nGhi đệm,\ncắt clip" <<newproc>> as P9
usecase "7.10\nDọn bằng chứng,\ntự bật lại 24/7" <<newproc>> as P10
rectangle "D7 | Camera, phiên live" <<newstore>> as D7
rectangle "D6 | Mô hình, pipeline" <<store>> as D6
rectangle "D3 | Job" <<store>> as D3
rectangle "D4 | Kết quả" <<store>> as D4
rectangle "D8 | Sự kiện live" <<newstore>> as D8
rectangle "D9 | Watchlist" <<newstore>> as D9
rectangle "D11 | Bản ghi video" <<newstore>> as D11
rectangle "D12 | Thư mục live/{phiên}\n(track tạm)" <<newstore>> as D12
U --> P1 : URL, vùng loại trừ,\n24/7, lệnh bật/dừng
P1 --> D7 : phiên queued /\nstop_requested
D7 --> P2 : phiên chờ
D6 --> P2 : snapshot pipeline
P2 --> D7 : starting / running / ...
P2 --> P3 : payload (nguồn, ngưỡng)
S --> P3 : segment HLS / RTSP
P3 --> P4 : frame + PTS + giờ luồng
P3 --> P9 : stream copy
P9 --> D11 : đoạn MP4 10 s,\nindex.jsonl, clip ±3 s
P4 --> P5 : 5 crop / track
P5 --> D12 : crop, keyframe, track.json
D12 --> P6 : track (stdout JSON)
P6 --> D3 : job succeeded
P6 --> D4 : appearance, detection,\nprediction, sighting_id
P6 --> P7 : biển đọc được
D9 --> P7
P7 --> D8 : alert
P6 --> D8 : track
P2 --> D8 : status / stats
D8 --> P8 : NOTIFY
P8 --> U : event-stream
D4 --> P10 : track quá hạn
P10 --> D4 : giữ 1 keyframe / xóa
P10 --> D7 : phiên mới cho camera 24/7
@enduml
