@startuml
!include _uc.iuml
left to right direction
title Hình 2.9 – Use case phân rã: Gán nhãn và hiệu chỉnh ngưỡng (mới)
actor "User\n(người gán)" as U
actor "Admin" as A
A --|> U
rectangle "Gán nhãn và hiệu chỉnh ngưỡng" {
  usecase "UC19 Tạo bộ mẫu\n(theo camera hoặc phiên)" <<new>> as C
  usecase "Lấy mẫu phân tầng\ntheo khoảng confidence" <<new>> as ST
  usecase "Lọc crop đủ rộng\n(min_crop_width)" <<new>> as W
  usecase "Xem danh sách bộ mẫu,\ntiến độ" <<new>> as LS
  usecase "UC19 Gán nhãn mù\n(mẫu kế tiếp)" <<new>> as N
  usecase "Gõ biển / không đọc được /\nbỏ qua" <<new>> as T
  usecase "Sửa nhãn của mình" <<new>> as E
  usecase "UC20 Báo cáo hiệu chỉnh\nngưỡng" <<new>> as R
  usecase "Tính nhãn đồng thuận\n(min_labels)" <<new>> as CON
  usecase "Xuất báo cáo (JSON/CSV)" <<new>> as X
  usecase "Xóa bộ mẫu" <<new>> as D
}
A -- C
A -- R
A -- D
U -- LS
U -- N
U -- E
C ..> ST : <<include>>
W ..> C : <<extend>>\n[có min_crop_width]
N ..> T : <<include>>
R ..> CON : <<include>>
X ..> R : <<extend>>\n[format = csv]
note right of N
  Người gán chỉ thấy 5 crop + 1 keyframe,
  không thấy kết quả máy hay nhãn người khác.
  Thứ tự mẫu xáo trộn ổn định theo từng người.
end note
@enduml
