@startuml
!include _style.iuml
skinparam defaultFontSize 13
title Hình 3.10 – Hoạt động: Từ frame live đến kết quả và cảnh báo (mới)
|Tiến trình live (Python)|
start
if (Loại nguồn?) then (YouTube)
  :yt-dlp lấy URL HLS (≤ max_height);
  :ffmpeg -re -copyts, bắt đầu ở segment mới nhất;
  :Pacer: đuổi kịp tối đa 1,3× sau khi kẹt mạng;
elseif () then (RTSP)
  :ffmpeg RTSP qua TCP, một kết nối;
  :Đọc kích thước từ header, giờ = giờ nhận frame;
else (file demo)
  :OpenCV đọc theo nhịp thật, lặp lại khi hết;
endif
:LiveReader: buffer 1,5 s, bỏ frame cũ nhất khi đầy;
:Adaptive sampling 8/12/15 fps, bỏ cảnh trống;
:YOLO11l (bỏ box trong vùng loại trừ) + BoT-SORT;
if (Track kết thúc hoặc quá max_track_seconds?) then (có)
  :Chọn 5 crop: bỏ box co đột ngột, lệch tỷ lệ, chạm mép;\nưu tiên crop lớn, rải theo thời gian;
  if (Đủ 5 frame khác nhau?) then (có)
    :OCR joint 5 crop, decoder beam_filter;
    :Gắn giờ luồng (PROGRAM-DATE-TIME) hoặc giờ nhận;
    if (confidence ≥ ngưỡng (0,96)?) then (có)
      :readable;
    else (không)
      :low_confidence / unreadable;
    endif
    :Ghi crop, keyframe, track.json; in dòng JSON track;
  else (không)
    :Bỏ track (thống kê rejected);
    stop
  endif
else (không)
  stop
endif
|Worker (Node)|
:Chuyển thư mục sang recognition/{job}, kiểm bằng chứng;
:Transaction: job succeeded + appearance + detection\n+ prediction + event track;
:Gán sighting_id (cùng biển ±1 ký tự, cùng camera, ≤ 5 phút);
if (Khớp watchlist (chính xác hoặc lệch 1 ký tự)?) then (có)
  :Ghi event alert cho chủ mục watchlist;
endif
if (readable hoặc có cảnh báo, camera có ghi hình?) then (có)
  :Yêu cầu cắt clip ±3 s khi bản ghi phủ hết track;
endif
:Trigger NOTIFY sau commit → SSE tới client;
stop
@enduml
