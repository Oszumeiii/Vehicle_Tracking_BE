@startuml
!include _style.iuml
skinparam defaultFontSize 12
hide circle
skinparam class {
  BackgroundColor<<new>> #DBEAFE
  BorderColor<<new>> #1D4ED8
}
hide stereotype
title Hình 6.3 – ERD PostgreSQL đến migration 0011 (bảng xanh dương và cột [mới] là phần bổ sung)
entity users {
  *id PK
  *email UQ
  *role
  *is_active
}
entity auth_sessions {
  *id PK
  *user_id FK
  *token_hash UQ
  expires_at, revoked_at
}
entity media_assets {
  *id PK
  *owner_id FK
  *storage_key UQ
  sha256
}
entity recognition_jobs {
  *id PK
  media_id FK (0..1)
  live_session_id FK (0..1) [mới]
  *status, stage, pipeline_snapshot
  live_track_key, captured_from, captured_to [mới]
  confidence_status, duplicate_of_job_id FK [mới]
  sighting_id, alerted [mới]
  evidence_bytes, evidence_pruned_at [mới]
  clip_storage_key [mới, 0011]
}
entity stream_sources <<new>> {
  *id PK
  *owner_id FK
  *name, *source_type (youtube|file|rtsp), *url
  *exclude_zones jsonb
  *always_on, *auto_settings jsonb
  keyframe_retention_hours, track_retention_days
}
entity live_sessions <<new>> {
  *id PK
  *stream_source_id FK
  *status, *pipeline_snapshot, *settings
  stop_requested_at, started_at, finished_at
  error_message, *stats jsonb, stats_at
  *tracks_count
}
entity live_session_events <<new>> {
  *id bigint identity PK
  *session_id FK
  *event_type, *payload jsonb, *created_at
}
entity plate_watchlist <<new>> {
  *id PK
  *owner_id FK
  *plate (UQ theo owner)
  note
}
entity evaluation_sets <<new>> {
  *id PK
  *created_by FK
  stream_source_id / live_session_id FK
  *params jsonb
}
entity evaluation_items <<new>> {
  *id PK
  *set_id FK
  *job_id FK (UQ theo set)
  *bin
}
entity evaluation_labels <<new>> {
  *item_id PK FK
  *labeler_id PK FK
  plate_text, labeled_at
}
entity plate_appearances {
  *id PK
  *job_id FK
  effective_text, *revision
}
entity plate_detections {
  *id PK
  *appearance_id FK
  *selected_order
}
entity ocr_predictions {
  *id PK
  detection_id FK
  appearance_id FK
}
entity recognition_reviews {
  *id PK
  *appearance_id FK
  *reviewer_id FK
  *revision
}
users ||--o{ auth_sessions
users ||--o{ media_assets
media_assets |o--o{ recognition_jobs
users ||--o{ stream_sources
stream_sources ||--o{ live_sessions
live_sessions ||--o{ live_session_events
live_sessions |o--o{ recognition_jobs
users ||--o{ plate_watchlist
users ||--o{ evaluation_sets
evaluation_sets ||--o{ evaluation_items
recognition_jobs ||--o{ evaluation_items
evaluation_items ||--o{ evaluation_labels
users ||--o{ evaluation_labels
recognition_jobs ||--o{ plate_appearances
plate_appearances ||--o{ plate_detections
plate_appearances |o--o{ ocr_predictions
plate_detections |o--o{ ocr_predictions
plate_appearances ||--o{ recognition_reviews
users ||--o{ recognition_reviews
note right of live_session_events
  Trigger AFTER INSERT gửi pg_notify(id);
  SSE đọc lại dòng đã commit theo id tăng dần.
end note
note bottom of live_sessions
  Unique index một phần: một phiên hoạt động mỗi camera.
end note
@enduml
