  :Trả 401;
  stop
else (có)
  :Xóa bộ đếm của email+IP;
  :Khóa dòng user, kiểm tra lại;
  :Sinh token, lưu SHA-256 vào auth_sessions;
endif
|User|
:Nhận access_token;
