@startuml
!include _uc.iuml
left to right direction
title Hình 2.1 – Use case tổng quát (cập nhật: nhóm xanh dương là phần mới)
actor "User" as U
actor "Admin" as A
actor "Worker\n(tác nhân hệ thống)" as W
actor "Kỹ thuật viên\nvận hành" as K
actor "Nguồn video live\n(YouTube / RTSP)" as S
A --|> U
rectangle "Hệ thống nhận diện biển số" {
  usecase "Đăng nhập / xác thực" as L
  usecase "Quản lý tài khoản\nvà phân quyền" as ACC
  usecase "Quản lý media" as M
  usecase "Quản lý job nhận diện" as J
  usecase "Xử lý nhận diện" as P
  usecase "Kiểm duyệt kết quả" as R
  usecase "Tra cứu và báo cáo" as T
  usecase "Quản trị vận hành" as O
  usecase "Quản lý camera live\nvà phiên live" <<new>> as C
  usecase "Theo dõi real-time,\nwatchlist và cảnh báo" <<new>> as RT
  usecase "Xem lại video\ncủa kết quả" <<new>> as V
  usecase "Gán nhãn độc lập" <<new>> as LB
  usecase "Hiệu chỉnh ngưỡng\n(bộ mẫu, báo cáo)" <<new>> as CAL
  usecase "Chạy phiên live\n(đọc luồng, nhập track)" <<new>> as LR
}
U -- L
U -- M
U -- J
U -- R
U -- T
U -- C
U -- RT
U -- V
U -- LB
A -- ACC
A -- CAL
ACC ..> L : <<include>>
P ..> J : <<extend>>
W -- P
W -- LR
LR ..> C : <<extend>>\n[phiên queued / camera 24/7]
LR -- S
V ..> R : <<extend>>
CAL ..> LB : <<include>>
K -- O
@enduml
