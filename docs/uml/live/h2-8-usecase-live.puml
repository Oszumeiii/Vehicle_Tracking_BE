@startuml
!include _uc.iuml
left to right direction
title Hình 2.8 – Use case phân rã: Camera live (mới)
actor "User" as U
actor "Admin" as A
actor "Worker" as W
actor "Nguồn video live" as S
A --|> U
rectangle "Camera live" {
  usecase "UC13 Thêm camera\nYouTube / RTSP" <<new>> as C1
  usecase "UC18 Thêm camera demo\n(video trong demo-videos)" <<new>> as C2
  usecase "Sửa camera: vùng loại trừ,\n24/7, ngưỡng, thời hạn lưu" <<new>> as C3
  usecase "Xóa camera" <<new>> as C4
  usecase "Xem snapshot" <<new>> as C5
  usecase "UC14 Bật phiên" <<new>> as S1
  usecase "UC14 Dừng phiên" <<new>> as S2
  usecase "Xem phiên, thống kê,\nlịch sử sự kiện" <<new>> as S3
  usecase "UC17 Xóa phiên và\nbằng chứng" <<new>> as S4
  usecase "UC15 Theo dõi real-time (SSE)" <<new>> as RT
  usecase "UC16 Quản lý watchlist" <<new>> as WL
  usecase "Nhận cảnh báo" <<new>> as AL
  usecase "UC21 Xem lại video\n(clip track / bản ghi camera)" <<new>> as V
  usecase "Kiểm tra quyền\nsở hữu camera" as OWN
  usecase "Che mật khẩu URL RTSP" as RED
  usecase "Chạy phiên: đọc luồng,\ntracking, OCR, nhập track" <<new>> as RUN
  usecase "Kết nối lại khi mất luồng" as REC
  usecase "Tự bật lại camera 24/7" as AUTO
  usecase "Ghi đệm video" as RECD
  usecase "Dọn bằng chứng (retention)" as RET
}
U -- C1
A -- C2
U -- C3
U -- C4
U -- C5
U -- S1
U -- S2
U -- S3
U -- S4
U -- RT
U -- WL
U -- V
C1 ..> RED : <<include>>
C3 ..> OWN : <<include>>
C4 ..> OWN : <<include>>
S1 ..> OWN : <<include>>
S4 ..> OWN : <<include>>
AL ..> RT : <<extend>>\n[biển khớp watchlist]
W -- RUN
W -- AUTO
W -- RET
RUN -- S
RUN ..> S1 : <<extend>>
REC ..> RUN : <<extend>>\n[mất frame 15 s]
RECD ..> RUN : <<extend>>\n[YouTube / RTSP]
AUTO ..> S1 : <<extend>>\n[always_on]
@enduml
