@startuml
!include _style.iuml
skinparam componentStyle rectangle
skinparam defaultFontSize 13
skinparam component {
  BackgroundColor<<new>> #DBEAFE
  BorderColor<<new>> #1D4ED8
}
hide stereotype
title Hình 7.1 – Biểu đồ thành phần (cập nhật: thành phần xanh dương là phần mới)
actor "User / Admin" as user
component "Frontend React\n(Vite / nginx)" as fe
cloud "YouTube Live (HLS)\nCamera IP (RTSP)" as src
package "API NestJS" {
  component "Auth (+ LoginThrottle)" as auth
  component "Media, Jobs, Results" as core
  component "Live: camera, phiên,\nsnapshot" <<new>> as live
  component "SSE hub\nLISTEN/NOTIFY" <<new>> as hub
  component "Watchlist, sighting" <<new>> as wl
  component "Video: clip, bản ghi" <<new>> as video
  component "Evaluation: bộ mẫu,\nnhãn, báo cáo" <<new>> as ev
}
package "Worker Node" {
  component "engine.ts\n(job upload)" as engine
  component "LiveManager + GpuGate" <<new>> as lm
  component "SharedLiveHost\n+ hostRunner" <<new>> as host
  component "Retention" <<new>> as ret
}
package "Python" {
  component "app.recognition\nsupervisor, video_tracking,\nicpr_adapter" as py
  component "app.live\nLiveRunner, Host (luồng live-gpu),\nFfmpegFrames / RtspFrames / FileFrames,\nRecorder, ClipMaker" <<new>> as pylive
  component "yt-dlp + ffmpeg\n(imageio-ffmpeg)" <<new>> as ff
}
database "PostgreSQL\n15 bảng + trigger NOTIFY" as db
folder "data/\nmedia, recognition,\nlive/{phiên}, recording" as files
user --> fe
fe --> auth : REST /api/v2
fe --> core
fe --> live
fe --> wl
fe --> video
fe --> ev
hub --> fe : SSE
core --> db
live --> db
wl --> db
ev --> db
db --> hub : NOTIFY
video --> files
engine --> db
engine <--> py : file JSON
lm --> db
lm <--> host
host <--> pylive : stdin/stdout JSON lines
engine ..> host : job video joint\nchạy trong host
pylive --> ff
ff --> src
pylive --> files
ret --> db
ret --> files
@enduml
