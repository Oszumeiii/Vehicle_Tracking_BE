@startuml
!include _style.iuml
skinparam defaultFontSize 12
hide circle
skinparam class {
  BackgroundColor<<new>> #DBEAFE
  BorderColor<<new>> #1D4ED8
}
hide stereotype
title Hình 6.1 – Lớp thực thể (cập nhật: lớp xanh dương là phần mới)
class User {
  id; email; role; is_active
  +login(); +logout()
}
class AuthSession {
  token_hash; expires_at; revoked_at
}
class MediaAsset {
  id; owner_id; kind; sha256
}
class RecognitionJob {
  id; status; stage; pipeline_snapshot
  media_id [0..1]; live_session_id [0..1]
  live_track_key; captured_from/to
  confidence_status; sighting_id
  alerted; evidence_bytes; clip_storage_key
}
class PlateAppearance {
  machine_text; effective_text; review_status; revision
}
class PlateDetection {
  selected_order; bbox; crop/frame key
}
class OcrPrediction {
  variant; text; confidence; decoding
}
class RecognitionReview {
  action; revision; reviewer_id
}
class StreamSource <<new>> {
  id; name; source_type (youtube | rtsp | file)
  url (mật khẩu che khi trả ra); exclude_zones
  always_on; auto_settings
  keyframe_retention_hours; track_retention_days
  +startSession(); +snapshot()
}
class LiveSession <<new>> {
  id; status; pipeline_snapshot; settings
  stop_requested_at; started_at; finished_at
  stats; tracks_count; error_message
  +stop()
}
class LiveSessionEvent <<new>> {
  id (tăng dần); event_type; payload
}
class PlateWatchlist <<new>> {
  plate; note
}
class EvaluationSet <<new>> {
  name; params (per_bin, min_crop_width)
}
class EvaluationItem <<new>> {
  bin
}
class EvaluationLabel <<new>> {
  plate_text (NULL = không đọc được); labeled_at
}
User "1" *-- "0..*" AuthSession
User "1" -- "0..*" MediaAsset : sở hữu
User "1" -- "0..*" StreamSource : sở hữu
User "1" -- "0..*" PlateWatchlist : theo dõi
MediaAsset "0..1" -- "0..*" RecognitionJob
StreamSource "1" -- "0..*" LiveSession
LiveSession "1" *-- "0..*" LiveSessionEvent
LiveSession "0..1" -- "0..*" RecognitionJob : một job / track
RecognitionJob "0..1" -- "0..*" RecognitionJob : duplicate_of
RecognitionJob "1" *-- "0..*" PlateAppearance
PlateAppearance "1" *-- "0..5" PlateDetection
PlateAppearance "1" *-- "0..1" OcrPrediction : joint
PlateDetection "1" *-- "0..*" OcrPrediction : per-crop
PlateAppearance "1" *-- "0..*" RecognitionReview
User "1" -- "0..*" RecognitionReview : reviewer
User "1" -- "0..*" EvaluationSet : tạo (Admin)
EvaluationSet "1" *-- "0..*" EvaluationItem
RecognitionJob "1" -- "0..*" EvaluationItem : được lấy mẫu
EvaluationItem "1" *-- "0..*" EvaluationLabel
User "1" -- "0..*" EvaluationLabel : người gán
note bottom of RecognitionJob
  XOR: đúng một trong media_id, live_session_id.
  sighting_id gom các track cùng lượt xe (không FK).
end note
@enduml
