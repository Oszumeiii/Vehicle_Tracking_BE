@startuml
!include _style.iuml
title Hình 3.11 – Hoạt động: Xem lại video của một kết quả (mới)
|User|
start
:Mở kết quả, bấm xem video;
|Hệ thống|
:Kiểm tra quyền sở hữu (404 nếu không);
if (Nguồn của kết quả?) then (upload)
  :kind = media: phát file gốc từ giây biển xuất hiện;
elseif () then (track có clip lưu sẵn)
  :kind = clip: phát clip ±3 s đã lưu cùng bằng chứng;
elseif () then (camera demo)
  :kind = demo: cắt đoạn từ file demo nguồn;
else (track YouTube/RTSP khác)
  if (Bản ghi đệm còn phủ khoảng thời gian track?\n(PLATE_LIVE_RECORD_MINUTES = 240)) then (có)
    :kind = recording: cắt bằng concat demuxer\ninpoint/outpoint, từ keyframe gần nhất;
  else (không)
    :kind = none, available = false;
    |User|
    :Thấy thông báo "không còn bản ghi";
    stop
  endif
endif
|Hệ thống|
:Trả MP4 (Range 206), header X-Plate-First-Seen-Seconds;
|User|
:Trình phát tua tới giây biển xuất hiện;
stop
@enduml
