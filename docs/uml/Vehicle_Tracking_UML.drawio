gt;original_name&lt;br&gt;media_type ∈ {image, video}&lt;br&gt;storage_key UQ&lt;br&gt;mime_type, size_bytes ≥ 0&lt;br&gt;sha256&lt;br&gt;width, height &gt; 0&lt;br&gt;duration_seconds ≥ 0&lt;br&gt;uploaded_at" style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5597;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="290" height="190" as="geometry"/></mxCell><mxCell id="c1188" value="&lt;b&gt;recognition_jobs&lt;/b&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt; PK&lt;br&gt;media_id FK → media_assets (RESTRICT)&lt;br&gt;job_kind ∈ {detect_only, recognize}&lt;br&gt;input_mode ∈ {scene, plate_crop}&lt;br&gt;pipeline_snapshot jsonb&lt;br&gt;status ∈ {queued, running, succeeded, failed}&lt;br&gt;stage&lt;br&gt;statistics jsonb&lt;br&gt;created_at, started_at, finished_at&lt;br&gt;error_code, error_message" style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5597;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="60" width="320" height="190" as="geometry"/></mxCell><mxCell id="c1189" value="&lt;b&gt;plate_appearances&lt;/b&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt; PK&lt;br&gt;job_id FK → recognition_jobs (CASCADE)&lt;br&gt;source_track_id&lt;br&gt;first_frame ≤ last_frame&lt;br&gt;start_seconds ≤ end_seconds&lt;br&gt;machine_text&lt;br&gt;machine_status ∈ {readable, ambiguous, unreadable, not_run}&lt;br&gt;agreement_count 0..5 | NULL&lt;br&gt;recognition_method&lt;br&gt;effective_text (index)&lt;br&gt;review_status (index)&lt;br&gt;revision ≥ 0" style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5597;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="450" width="340" height="222" as="geometry"/></mxCell><mxCell id="c1190" value="&lt;b&gt;plate_detections&lt;/b&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt; PK&lt;br&gt;appearance_id FK (CASCADE)&lt;br&gt;selected_order (UQ cùng appearance)&lt;br&gt;frame_index, timestamp_seconds&lt;br&gt;timestamp_source&lt;br&gt;bbox, crop_bbox jsonb&lt;br&gt;detection_score ∈ [0, 1]&lt;br&gt;crop_storage_key, frame_storage_key&lt;br&gt;crop_width, crop_height" style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5597;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="450" width="300" height="175" as="geometry"/></mxCell><mxCell id="c1191" value="&lt;b&gt;ocr_predictions&lt;/b&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt; PK&lt;br&gt;detection_id FK | appearance_id FK (đúng 1)&lt;br&gt;variant (UQ theo parent)&lt;br&gt;raw_text, normalized_text&lt;br&gt;ocr_score, character_scores&lt;br&gt;input_storage_key | input_storage_keys[5]&lt;br&gt;frame_weights[5]&lt;br&gt;decoding jsonb&lt;br&gt;latency_ms, created_at" style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5597;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="820" width="300" height="175" as="geometry"/></mxCell><mxCell id="c1192" value="&lt;b&gt;recognition_reviews&lt;/b&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt; PK&lt;br&gt;appearance_id FK (CASCADE)&lt;br&gt;reviewer_id FK → users (RESTRICT)&lt;br&gt;action ∈ {confirm, correct, unreadable, reject}&lt;br&gt;corrected_text, note&lt;br&gt;revision &gt; 0 (UQ cùng appearance)&lt;br&gt;created_at" style="fontFamily=Helvetica;fontSize=12;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5597;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="320" height="144" as="geometry"/></mxCell><mxCell id="c1193" value="&lt;b&gt;schema_migrations&lt;/b&gt;&lt;hr&gt;&lt;u