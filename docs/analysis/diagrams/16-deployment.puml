@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam backgroundColor white
left to right direction
node "Máy người dùng" {
  artifact "HTTP client\nSwagger hoặc frontend" as client
}
node "Host ứng dụng (1 GPU)" {
  artifact "NestJS API\nnpm start\nSSE hub" as api
  artifact "Node worker\nnpm run worker\nlive manager, dọn dữ liệu" as worker
  artifact "Python environment\nCUDA" as python
  artifact "python -m app.live [--host]\n+ ffmpeg (imageio-ffmpeg)" as live
  folder "Storage data\n(+ demo-videos)" as storage
  folder "app/recognition\nProfile và checkpoint" as model
}
node "PostgreSQL host\nCó thể cùng máy" {
  database "Business database" as db
}
cloud "YouTube" as youtube
client --> api : HTTP(S), SSE
api --> db : DATABASE_URL\n+ kết nối LISTEN
worker --> db : DATABASE_URL và advisory lock
api --> storage : PLATE_DATA_DIR
worker --> python : Job upload (giám sát)
worker --> live : Phiên live (stdin/stdout)
live --> youtube : HLS ~4 Mbit/s (1080p)
python --> storage : Nguồn / crop / keyframe
live --> storage : live/{phiên}/tracks
python --> model : Snapshot và checksum
note bottom of worker
  PLATE_LIVE_EXCLUSIVE_GPU: job upload và
  phiên live không chạy cùng lúc trên GPU 8 GB.
  PLATE_LIVE_MAX_SESSIONS >= 2: các phiên chạy
  trong một host dùng chung model (2 camera / 8 GB).
end note
@enduml
