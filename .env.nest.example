DATABASE_URL=postgresql://plate:change-me@127.0.0.1:5432/plate
PORT=3000
HOST=127.0.0.1
PLATE_DATA_DIR=data
PLATE_PIPELINE_PYTHON=.venv/Scripts/python.exe
PLATE_PIPELINES_CONFIG=config/pipelines.kaggle.json
PLATE_CACHE_DIR=data/model-cache
# cuda khi đã cài PyTorch CUDA (xem README); cpu nếu không có GPU NVIDIA.
PLATE_DEVICE=cuda
PLATE_MAX_UPLOAD_MIB=500
PLATE_POLL_SECONDS=2
# Số job xử lý song song trong một worker (1-8); mỗi job nạp YOLO11l + OCR riêng (~2-3 GB VRAM).
PLATE_WORKER_CONCURRENCY=2
PLATE_JOB_TIMEOUT_SECONDS=7200
PLATE_SESSION_HOURS=12
CORS_ORIGINS=http://localhost:5173
# Used only by docker compose; choose your own local database password.
POSTGRES_PASSWORD=change-me
